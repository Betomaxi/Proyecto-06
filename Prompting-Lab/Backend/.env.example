# Copy to .env in this folder. main.py reads these with os.getenv.

# Port when started with: python main.py
# Default: 8111
API_PORT=8111

# Root for datasets/ and experiments/.
# Default: the directory that contains main.py
PROJECT_BASE_DIR=

# Model when the request omits model_name.
# Experiment default: mock-model. OpenAI chat default: gpt-4o-mini.
DEFAULT_MODEL_NAME=mock-model

# If set, call_llm posts to {OLLAMA_HOST}/api/generate first.
# Example: http://localhost:11434
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Used only when OLLAMA_HOST is empty. LLM_API_KEY is the fallback key.
OPENAI_API_KEY=
LLM_API_KEY=
